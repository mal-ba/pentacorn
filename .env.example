# 서버 포트
PORT=3000

# 세션 쿠키 서명에 쓰는 임의의 긴 문자열 (아무 랜덤 문자열로 바꾸세요)
SESSION_SECRET=change-this-to-a-long-random-string

# ── Google 로그인 ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials 에서
# "OAuth 클라이언트 ID" (웹 애플리케이션)를 만들고 여기에 붙여넣으세요.
# 승인된 자바스크립트 원본(Authorized JavaScript origins)에
# http://localhost:3000 을 꼭 등록해야 로그인 버튼이 동작합니다.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── 토스페이먼츠 결제 ──────────────────────────────────────────
# 아래 값은 토스페이먼츠가 "회원가입/사업자 등록 전"에도
# 누구나 테스트해볼 수 있도록 공식 문서에 공개한 테스트 키입니다.
# (실제 결제는 절대 일어나지 않고, 가상으로만 승인됩니다)
# 나중에 https://developers.tosspayments.com 에 가입하면
# 내 상점의 테스트 키로 바꿔서 결제 내역을 확인할 수 있어요.
TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# ── 관리자(공식 옷장) 계정 ──────────────────────────────────────
# 여기 등록한 구글 계정(이메일)으로 로그인해서 옷장에 아이템을 올리면
# "공식" 배지가 붙고 목록 맨 위에 먼저 노출돼요. 여러 명이면 쉼표로 구분하세요.
# 예: ADMIN_EMAILS=jaehoon@gmail.com,teammate@gmail.com
ADMIN_EMAILS=
